# ────────────────────────────────────
# 企业微信配置
# ────────────────────────────────────

# 企业 ID
WX_CORP_ID=wwbb77df7c639df208

# 会话存档专用 Secret（用于调用 getChatData SDK）
WECOM_CHATDATA_SECRET=your_chatdata_secret_here

# 自建应用 Secret（用于查询外部联系人姓名，需开通「客户联系」权限）
WX_AGENT_SECRET=your_agent_secret_here

# ────────────────────────────────────
# 服务配置
# ────────────────────────────────────

# GCS 状态桶名（用于保存拉取进度，deploy.sh 会自动创建）
STATE_BUCKET=wechat-archiver-state

# 起始 seq（首次部署时从哪条消息开始，6047 是上次停止的位置）
START_SEQ=6047

# 拉取间隔（毫秒，默认 3000）
POLL_INTERVAL_MS=3000
